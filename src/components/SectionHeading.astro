---
interface Props {
	title: string;
	subtitle?: string;
	id?: string;
}

const { title, subtitle = 'Recognitions & accomplishments', id } = Astro.props;
---

<header class="section-heading">
	<span class="burst" aria-hidden="true">✺</span>
	<h2 id={id}>{title}</h2>
	<p>{subtitle}</p>
</header>

<style>
	.section-heading {
		text-align: center;
	}

	.section-heading .burst {
		margin-bottom: 16px;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 34px;
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.section-heading p {
		margin: 17px 0 0;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>
