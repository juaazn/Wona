---
import type { SiteCopy } from '../i18n/translations';

interface Props {
	copy: SiteCopy['contactModal'];
}

const { copy } = Astro.props;
const whatsappNumber = '+34 654 54 96 66';
const whatsappUrl = 'https://wa.me/34654549666';
const email = 'info@wona.com';
---

<dialog class="contact-modal" id="contact-dialog" data-contact-dialog aria-labelledby="contact-dialog-title">
	<div class="contact-modal__inner">
		<form method="dialog">
			<button class="contact-modal__close" type="submit" aria-label={copy.close}>
				<span aria-hidden="true">×</span>
			</button>
		</form>

		<p class="eyebrow">{copy.eyebrow}</p>
		<h2 id="contact-dialog-title">{copy.title}</h2>
		<p class="contact-modal__description">{copy.description}</p>

		<div class="contact-modal__links">
			<a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
				<span>{copy.whatsapp}</span>
				<strong>{whatsappNumber}</strong>
				<i aria-hidden="true">↗</i>
			</a>
			<a href={`mailto:${email}`}>
				<span>{copy.email}</span>
				<strong>{email}</strong>
				<i aria-hidden="true">↗</i>
			</a>
		</div>
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-contact-dialog]');
	const openers = document.querySelectorAll<HTMLElement>('[data-contact-modal]');

	openers.forEach((opener) => {
		opener.addEventListener('click', (event) => {
			event.preventDefault();
			if (dialog && !dialog.open) dialog.showModal();
		});
	});

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});
</script>

<style>
	.contact-modal {
		width: min(calc(100% - 32px), 660px);
		max-width: none;
		margin: auto;
		border: 1px solid var(--color-border);
		padding: 0;
		background: var(--color-paper-light);
		color: var(--color-ink);
	}

	.contact-modal::backdrop {
		background: rgba(17, 17, 15, 0.72);
		backdrop-filter: blur(4px);
	}

	.contact-modal__inner {
		position: relative;
		padding: 58px;
	}

	.contact-modal__close {
		position: absolute;
		top: 20px;
		right: 20px;
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 1px solid var(--color-border);
		background: transparent;
		color: inherit;
		font-size: 25px;
		line-height: 1;
		cursor: pointer;
	}

	.contact-modal__close:hover,
	.contact-modal__close:focus-visible {
		background: var(--color-ink);
		color: white;
	}

	.contact-modal h2 {
		margin: 18px 0 14px;
		font-size: clamp(42px, 7vw, 64px);
		font-weight: 800;
		letter-spacing: -0.06em;
		line-height: 0.95;
		text-transform: uppercase;
	}

	.contact-modal__description {
		max-width: 440px;
		margin: 0 0 38px;
		color: var(--color-muted);
		font-size: 13px;
		line-height: 1.6;
	}

	.contact-modal__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border: 1px solid var(--color-border);
	}

	.contact-modal__links a {
		position: relative;
		display: flex;
		min-height: 130px;
		flex-direction: column;
		justify-content: space-between;
		padding: 22px;
		color: inherit;
		text-decoration: none;
	}

	.contact-modal__links a + a {
		border-left: 1px solid var(--color-border);
	}

	.contact-modal__links a:hover,
	.contact-modal__links a:focus-visible {
		background: var(--color-accent);
		color: white;
	}

	.contact-modal__links span {
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.contact-modal__links strong {
		font-size: 15px;
		letter-spacing: -0.03em;
	}

	.contact-modal__links i {
		position: absolute;
		top: 20px;
		right: 20px;
		font-style: normal;
	}

	@media (max-width: 560px) {
		.contact-modal__inner {
			padding: 56px 24px 24px;
		}

		.contact-modal h2 {
			font-size: 42px;
		}

		.contact-modal__links {
			grid-template-columns: 1fr;
		}

		.contact-modal__links a + a {
			border-top: 1px solid var(--color-border);
			border-left: 0;
		}
	}
</style>
