---
import type { SiteCopy } from '../i18n/translations';

interface Props {
	copy: SiteCopy['header'];
}

const { copy } = Astro.props;
---

<header class="site-header">
	<div class="site-header__inner page-shell">
		<a class="brand" href="#top" aria-label={copy.brandLabel}>
			<span class="brand__mark" aria-hidden="true">✺</span>
			<span>wona.</span>
		</a>

		<nav class="desktop-nav" aria-label={copy.primaryNavLabel}>
			<a href="#top">{copy.home}</a>
			<a href="#about">{copy.about}</a>
			<a href="#contact">{copy.contact}</a>
		</nav>

		<a class="header-cta" href="#contact" data-contact-modal>{copy.talk}</a>

		<details class="mobile-menu">
			<summary aria-label={copy.openNavigation}>{copy.menu}</summary>
			<nav aria-label={copy.mobileNavLabel}>
				<a href="#top">{copy.home}</a>
				<a href="#about">{copy.about}</a>
				<a href="#portfolio">{copy.portfolio}</a>
				<a href="#contact">{copy.contact}</a>
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 20;
		height: 92px;
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		height: 100%;
	}

	.brand {
		display: inline-flex;
		width: max-content;
		align-items: center;
		gap: 8px;
		font-size: 22px;
		font-weight: 800;
		letter-spacing: -0.06em;
		text-decoration: none;
	}

	.brand__mark {
		color: var(--color-accent);
		font-size: 25px;
		font-weight: 400;
		line-height: 1;
	}

	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 34px;
	}

	.desktop-nav a,
	.header-cta {
		font-size: 10px;
		font-weight: 700;
		text-decoration: none;
	}

	.desktop-nav a {
		position: relative;
		padding-block: 8px;
	}

	.desktop-nav a::after {
		position: absolute;
		bottom: 2px;
		left: 0;
		width: 100%;
		height: 1px;
		transform: scaleX(0);
		transform-origin: right;
		background: currentColor;
		content: '';
		transition: transform 160ms ease;
	}

	.desktop-nav a:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.header-cta {
		justify-self: end;
		border: 1px solid #8d8b87;
		padding: 10px 21px;
		transition: background-color 160ms ease, color 160ms ease;
	}

	.header-cta:hover {
		background: var(--color-ink);
		color: white;
	}

	.mobile-menu {
		display: none;
	}

	@media (max-width: 760px) {
		.site-header {
			height: 72px;
		}

		.site-header__inner {
			grid-template-columns: 1fr auto;
		}

		.brand {
			font-size: 20px;
		}

		.desktop-nav,
		.header-cta {
			display: none;
		}

		.mobile-menu {
			position: relative;
			display: block;
		}

		.mobile-menu summary {
			border: 1px solid var(--color-border);
			padding: 9px 13px;
			font-size: 10px;
			font-weight: 700;
			list-style: none;
			text-transform: uppercase;
			cursor: pointer;
		}

		.mobile-menu summary::-webkit-details-marker {
			display: none;
		}

		.mobile-menu nav {
			position: absolute;
			top: calc(100% + 8px);
			right: 0;
			display: grid;
			width: 150px;
			border: 1px solid var(--color-border);
			background: var(--color-paper);
		}

		.mobile-menu nav a {
			padding: 12px 14px;
			border-bottom: 1px solid var(--color-border);
			font-size: 11px;
			font-weight: 700;
			text-decoration: none;
		}

		.mobile-menu nav a:last-child {
			border-bottom: 0;
		}
	}
</style>
